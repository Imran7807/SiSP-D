<!DOCTYPE html>
<html lang="en">
<head>
<%- include('head', { title: 'Payment — ' + companyName }) %>
</head>
<body>
<%- include('header') %>

<section class="section" style="padding-top:52px;">
  <div class="container">
    <div class="section-head">
      <div class="eyebrow">Payment</div>
      <h1 style="font-size:1.9rem;">Complete your payment</h1>
      <p>
        Package: <strong><%= subscription.speedLabel %></strong> —
        Rs. <strong><%= subscription.price.toLocaleString() %></strong> / month
      </p>
    </div>

    <% if (error) { %><div class="error-banner" style="max-width:620px;margin:0 auto 22px;"><%= error %></div><% } %>

    <div class="pay-grid" style="max-width:900px;margin:0 auto;">
      <div class="qr-box">
        <% if (settings.qrCodeImage) { %>
          <img src="<%= settings.qrCodeImage %>" alt="Payment QR code" />
        <% } else { %>
          <p style="margin-bottom:16px;">QR code not set up yet. Please use the account details to pay.</p>
        <% } %>
        <div class="pay-detail-row">
          <span class="label">Account title</span>
          <span class="value"><%= settings.accountTitle || '—' %></span>
        </div>
        <div class="pay-detail-row">
          <span class="label">Account number</span>
          <span class="value"><%= settings.accountNumber || '—' %></span>
        </div>
        <div class="pay-detail-row">
          <span class="label">JazzCash</span>
          <span class="value"><%= settings.jazzCashNumber || '—' %></span>
        </div>
        <div class="pay-detail-row">
          <span class="label">Easypaisa</span>
          <span class="value"><%= settings.easypaisaNumber || '—' %></span>
        </div>
      </div>

      <div class="form-shell" style="max-width:none;">
        <h3 style="font-size:1rem;">Upload payment screenshot</h3>
        <p style="margin-bottom:20px;">After paying via QR code, bank transfer, JazzCash, or Easypaisa, upload a screenshot of the transaction below.</p>
        <form action="/payment/<%= subscription._id %>" method="POST" enctype="multipart/form-data">
          <div class="field">
            <label class="upload-box">
              <img class="preview" alt="" />
              <div class="upload-label">Click to upload transaction screenshot</div>
              <div class="upload-sub">JPG or PNG, up to 5MB</div>
              <input type="file" name="screenshot" accept="image/*" required />
            </label>
          </div>
          <button type="submit" class="btn btn-primary btn-block">Submit Payment</button>
        </form>
        <p class="hint" style="margin-top:14px;">Your package will show as "Pending" until an admin reviews and approves your payment.</p>
      </div>
    </div>
  </div>
</section>

<%- include('footer') %>
</body>
</html>
