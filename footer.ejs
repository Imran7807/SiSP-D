<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div>
        <div class="brand" style="margin-bottom:12px;">
          <span class="brand-mark" aria-hidden="true"></span>
          <%= companyName %>
        </div>
        <p style="max-width:32ch;color:rgba(245,248,251,0.55);">
